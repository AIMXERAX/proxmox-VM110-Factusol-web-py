# ==============================================
# PLANTILLA DE CONSTANTES SENSIBLES
# ==============================================
# ⚠️  INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Rellena con tus valores reales
# 3. NO subir el archivo .env al repositorio

# Año del ejercicio de Factusol
ANIO=2025

# Único modelo de operación
MODELO=PROD

# IP del servidor de Factusol
IP_SERVIDOR_PROD=192.168.100.104

# Configuración FTP/SFTP PROD - CREDENCIALES SENSIBLES
FTP_HOST_PROD=tu_host_ftp_prod
FTP_USER_PROD=tu_usuario_ftp_prod
FTP_PASSWORD_PROD=tu_password_ftp_prod

# Palabra clave para autenticación - MUY SENSIBLE
PALABRA_CLAVE=tu_palabra_clave_secreta_aqui

# URLs de servidor - DATOS SENSIBLES
URL_IONOS_PROD=http://tu-servidor-produccion.com/actualizar_bd_incremental.php
